{
  "SessionStart": [
    { "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-session.mjs" }] }
  ],
  "UserPromptSubmit": [
    { "hooks": [{ "type": "command", "command": "{KNOWLEDGE} hook prompt --harness claude" }] }
  ],
  "SessionEnd": [
    { "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-capture.mjs", "timeout": 10 }] }
  ],
  "PreCompact": [
    { "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-capture.mjs", "timeout": 10 }] }
  ],
  "Stop": [
    { "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-capture.mjs", "timeout": 10, "async": true }] }
  ],
  "SubagentStop": [
    { "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-capture.mjs", "timeout": 10, "async": true }] }
  ],
  "PreToolUse": [
    { "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|mcp__.*", "hooks": [
      { "type": "command", "command": "{KNOWLEDGE} hook pre-tool --harness claude", "timeout": 5 }
    ] }
  ],
  "PostToolUse": [
    { "matcher": "Edit|Write", "hooks": [
      { "type": "command", "command": "{KNOWLEDGE} hook post-edit --harness claude" }
    ] },
    { "matcher": "Bash", "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-commit.mjs", "timeout": 15, "async": true }] }
  ],
  "PostToolUseFailure": [
    { "matcher": "Bash", "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-commit.mjs", "timeout": 15, "async": true }] }
  ]
}
