#!/bin/sh
# Pre-commit secret scan for the vault and the skeleton clone. install.ts points core.hooksPath
# here. Fails closed: a commit without the scan is a commit nobody checked (0012-records-never-committed-unscanned).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not on PATH; commit refused. Install it, then commit again." >&2
  exit 1
fi
exec gitleaks git --staged --no-banner --redact .
